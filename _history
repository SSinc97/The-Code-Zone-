ap(Projectile, Rock, hit_rock)\r\n\r\ndef game_over(player, proj):\r\n    game.over(False)\r\nsprites.on_overlap(Player, Projectile, game_over)\r\n\r\ndef fix_double_rock(rock, other_rock):\r\n    other_rock.destroy()\r\nsprites.on_overlap(Rock, Rock, fix_double_rock)\r\n\r\ndef reactivate_controls():\r\n    controller.move_sprite(red)\r\n    red.set_velocity(0, 0)\r\n\r\ndef knock_back(player, skull):\r\n    controller.move_sprite(red, 0, 0)\r\n    angle = spriteutils.angle_from(skull, player)\r\n    spriteutils.set_velocity_at_angle(player, angle, 150)\r\n    timer.after(100, reactivate_controls)\r\nsprites.on_overlap(Player, Enemy, knock_back)\r\n\r\ndef overlap_rock(player, rock):\r\n    angle = spriteutils.angle_from(rock, player)\r\n    spriteutils.place_angle_from(player, angle, 16, rock)\r\nsprites.on_overlap(Player, Rock, overlap_rock)\r\n\r\ndef spawn_rock():\r\n    rock = sprites.create(image.create(16, 16), Rock)\r\n    spriteutils.place_angle_from(rock, randint(0, Math.PI * 2), 35, spriteutils.pos(skull.x, skull.y))\r\n    anim = assets.animation(\"entry\")\r\n    frame_len = 100\r\n    scene.camera_shake(4, len(anim) * frame_len)\r\n    animation.run_image_animation(rock, anim, frame_len, False)\r\n    pause(randint(2500, 8000))\r\n    anim.reverse()\r\n    animation.run_image_animation(rock, anim, frame_len, False)\r\n    rock.lifespan = frame_len * len(anim)\r\n\r\ndef generate_projectiles(time):\r\n    arc_size = randint(1, 3) * 90\r\n    start = randint(1, 360)\r\n    for angle in range(0, arc_size, 10):\r\n        fire_angle = spriteutils.degrees_to_radians(start + angle)\r\n        proj = sprites.create(assets.image(\"projectile\"), Projectile)\r\n        proj.set_position(skull.x, skull.y)\r\n        proj.z = -1\r\n        proj.set_flag(SpriteFlag.AUTO_DESTROY, True)\r\n        spriteutils.set_velocity_at_angle(proj, fire_angle, 40)\r\n        pause(time)\r\n\r\ndef fire():\r\n    for i in range(randint(1, 3)):\r\n        timer.background(spawn_rock)\r\n    music.play(music.melody_playable(music.buzzer), music.PlaybackMode.UNTIL_DONE)\r\n    if randint(1, 2) == 2:\r\n        generate_projectiles(50)\r\n    else:\r\n        generate_projectiles(0)\r\ngame.on_update_random_interval(3500, 5000, False, fire)\r\n","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myTiles\"\n    }\n}","tilemap.g.ts":"","images.g.jres":"{\n    \"image4\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"flaming skull\"\n    },\n    \"image2\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABABAAAAAAAAFRFAAAAAAAAVEUAAAAAAABABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"projectile\"\n    },\n    \"image5\": {\n        \"data\": \"hwQQABAAAAAAAAAAAMDMzAAAAADMvMzMAAAAzL28y8wAAMzM28vLzADAu83cy8zMANu927zLzMyw3d3bu8u8zLDd3du7zLzL293d3My7vLvb3d3MzLy9u9vdvczdu727293N3N29zbu73cvc3b3NvLDMzNzdzc3MAADMzN3Ly8wAAADAzMzMzA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"rock\"\n    },\n    \"image1\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"background\"\n    },\n    \"image7\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAACwuwAAAAAAALDVy8zMAAAAsNW9W8UAAAC7VV1VzQAAsFtVVdXNAABbVVVV1QwAsF1VVVW1DAAAWxVRVdUMAACwG1FV1c0AAAC7VV1VzQAAALDVvVvFAAAAsNXLzMwAAACwuwAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\":